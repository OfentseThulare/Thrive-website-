# Public Supabase settings are optional for seed content mode.
# Supply both values together. A partial configuration is rejected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used for metadata and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only integrations. These are deliberately disabled until Tasks 4 and 5.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
