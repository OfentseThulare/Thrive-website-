# Public Supabase settings are optional for seed content mode.
# Supply both values together. A partial configuration is rejected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only booking boundary. Never prefix either value with NEXT_PUBLIC_.
# Use separate random values of at least 32 characters for both booking secrets.
SUPABASE_SERVICE_ROLE_KEY=
BOOKING_RATE_LIMIT_SECRET=
BOOKING_ACCESS_TOKEN_SECRET=

# Public origin used for metadata and canonical URLs.
# Production requires a public HTTPS origin. Localhost is accepted only in development and tests.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Booking is fail closed unless this is explicitly set to google.
# "disabled" is the safe prelaunch setting. "mock" is accepted in tests and
# local development only and is rejected in production.
BOOKING_CALENDAR_MODE=disabled
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Server only payment integration. Task 5 will activate this integration.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
